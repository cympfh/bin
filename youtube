@click.group()
def main() -> None:
    """YouTube 操作 (検索 / プレイリスト / OAuth)。"""


@main.command("auth")
@click.option("--port", default=DEFAULT_REDIRECT_PORT, show_default=True, help="redirect 用ローカル port")
@click.option("--code", "manual_code", default=None, help="手動で得た authorization code")
@click.option("--client-id", default=None, help="client_id を保存してから auth")
@click.option("--client-secret", default=None, help="client_secret を保存してから auth")
@click.option("--from-json", "from_json", type=click.Path(exists=True), help="Google の client_secret JSON を取り込む")
def auth_cmd(
    port: int,
    manual_code: str | None,
    client_id: str | None,
    client_secret: str | None,
    from_json: str | None,
) -> None:
    """OAuth で YouTube アカウントを認可し token を保存する。

    \b
    初回セットアップ:
      1. https://console.cloud.google.com/ でプロジェクト選択
      2. API とサービス → ライブラリ → YouTube Data API v3 を有効化
      3. OAuth 同意画面 (外部 / テストユーザーに自分を追加)
      4. 認証情報 → OAuth クライアント ID → デスクトップアプリ 作成
      5. JSON ダウンロード → youtube auth --from-json ~/Downloads/client_secret_*.json
      6. ブラウザで許可

    \b
    redirect URI (コンソールに追加が必要な場合):
      http://localhost:8765/
    """
    if from_json:
        raw = json.loads(Path(from_json).read_text())
        data = raw.get("installed") or raw.get("web") or raw
        client_id = data["client_id"]
        client_secret = data["client_secret"]
        click.echo(f"imported client_id={client_id[:20]}...")

    if client_id and client_secret:
        save_client(client_id, client_secret)
        click.echo(f"saved → {CLIENT_PATH}")

    # 存在確認
    load_client()

    redirect_uri = f"http://localhost:{port}/"
    if manual_code:
        code, err = _parse_oauth_redirect(manual_code)
        if err and not code:
            raise click.ClickException(f"認可エラー: {err}")
        if not code:
            raise click.ClickException("--code から authorization code を解釈できない")
        token = exchange_code(code, redirect_uri)
    else:
        token = run_oauth_flow(port=port)

    save_token(token)
    click.echo(f"token saved → {TOKEN_PATH}")
    # 動作確認
    me = api("GET", "channels", params={"part": "snippet", "mine": "true"})
    items = me.get("items") or []
    if items:
        title = items[0]["snippet"]["title"]
        ch_id = items[0]["id"]
        click.echo(f"OK as: {title} ({ch_id})")
    else:
        click.echo("token OK (channel 情報なし)")


@main.command("status")
def status_cmd() -> None:
    """認証・設定の状態を表示。"""
    click.echo(f"config_dir: {CONFIG_DIR}")
    click.echo(f"client: {'yes' if CLIENT_PATH.exists() or (os.environ.get('YOUTUBE_CLIENT_ID') and os.environ.get('YOUTUBE_CLIENT_SECRET')) else 'no'}")
    click.echo(f"api_key: {'yes' if os.environ.get('YOUTUBE_API_KEY') else 'no'}")
    token = load_token()
    if not token:
        click.echo("token: no")
        return
    click.echo(f"token: yes (refresh={'yes' if token.get('refresh_token') else 'no'})")
    try:
        me = api("GET", "channels", params={"part": "snippet,statistics", "mine": "true"})
        items = me.get("items") or []
        if items:
            sn = items[0]["snippet"]
            st = items[0].get("statistics", {})
            click.echo(f"channel: {sn['title']} ({items[0]['id']})")
            click.echo(f"subs: {st.get('subscriberCount', '?')}  videos: {st.get('videoCount', '?')}")
        else:
            click.echo("channel: (none)")
    except click.ClickException as e:
        click.echo(f"auth check failed: {e}")


@main.command("search")
@click.argument("query")
@click.option("-n", "--max", "max_results", default=5, show_default=True)
@click.option("--order", default="relevance", show_default=True, type=click.Choice(["relevance", "date", "viewCount", "rating", "title"]))
@click.option("--type", "result_type", default="video", show_default=True)
@click.option("--json", "as_json", is_flag=True)
def search_cmd(query: str, max_results: int, order: str, result_type: str, as_json: bool) -> None:
    """動画を検索する (API key)。"""
    data = api(
        "GET",
        "search",
        params={
            "part": "snippet",
            "q": query,
            "maxResults": max_results,
            "order": order,
            "type": result_type,
        },
        auth=False,
        use_key=True,
    )
    if as_json:
        out(data, True)
        return
    for i, item in enumerate(data.get("items") or [], 1):
        sn = item["snippet"]
        vid = (item.get("id") or {}).get("videoId") or (item.get("id") or {}).get("playlistId") or ""
        kind = (item.get("id") or {}).get("kind", "").split("#")[-1]
        click.echo(f"{i}. [{kind}] {sn['title']}")
        click.echo(f"   {sn['channelTitle']}  {sn.get('publishedAt', '')[:10]}")
        if vid:
            url = f"https://www.youtube.com/watch?v={vid}" if kind == "video" else f"https://www.youtube.com/playlist?list={vid}"
            click.echo(f"   {url}")
            click.echo(f"   id={vid}")


@main.group("playlist")
def playlist_group() -> None:
    """プレイリスト操作 (OAuth 必須)。"""


@playlist_group.command("list")
@click.option("-n", "--max", "max_results", default=25, show_default=True)
@click.option("--json", "as_json", is_flag=True)
def playlist_list(max_results: int, as_json: bool) -> None:
    """自分のプレイリスト一覧。"""
    data = api(
        "GET",
        "playlists",
        params={"part": "snippet,contentDetails,status", "mine": "true", "maxResults": max_results},
    )
    if as_json:
        out(data, True)
        return
    items = data.get("items") or []
    if not items:
        click.echo("(empty)")
        return
    for p in items:
        sn = p["snippet"]
        n = p.get("contentDetails", {}).get("itemCount", "?")
        priv = p.get("status", {}).get("privacyStatus", "?")
        click.echo(f"{p['id']}  [{priv}] ({n})  {sn['title']}")
        click.echo(f"  https://www.youtube.com/playlist?list={p['id']}")


@playlist_group.command("create")
@click.argument("title")
@click.option("--desc", "description", default="", help="説明")
@click.option(
    "--privacy",
    default="private",
    show_default=True,
    type=click.Choice(["private", "unlisted", "public"]),
)
@click.option("--json", "as_json", is_flag=True)
def playlist_create(title: str, description: str, privacy: str, as_json: bool) -> None:
    """プレイリストを新規作成。"""
    data = api(
        "POST",
        "playlists",
        params={"part": "snippet,status"},
        body={
            "snippet": {"title": title, "description": description},
            "status": {"privacyStatus": privacy},
        },
    )
    if as_json:
        out(data, True)
        return
    pid = data["id"]
    click.echo(f"created: {data['snippet']['title']}")
    click.echo(f"id: {pid}")
    click.echo(f"url: https://www.youtube.com/playlist?list={pid}")
    click.echo(f"privacy: {data['status']['privacyStatus']}")


@playlist_group.command("add")
@click.argument("playlist")
@click.argument("videos", nargs=-1, required=True)
@click.option("--json", "as_json", is_flag=True)
def playlist_add(playlist: str, videos: tuple[str, ...], as_json: bool) -> None:
    """プレイリストに動画を追加。VIDEO は id または URL。"""
    pid = extract_playlist_id(playlist)
    results = []
    for v in videos:
        vid = extract_video_id(v)
        data = api(
            "POST",
            "playlistItems",
            params={"part": "snippet"},
            body={
                "snippet": {
                    "playlistId": pid,
                    "resourceId": {"kind": "youtube#video", "videoId": vid},
                }
            },
        )
        results.append(data)
        if not as_json:
            title = data.get("snippet", {}).get("title", vid)
            click.echo(f"+ {vid}  {title}")
    if as_json:
        out(results, True)


@playlist_group.command("items")
@click.argument("playlist")
@click.option("-n", "--max", "max_results", default=50, show_default=True)
@click.option("--json", "as_json", is_flag=True)
def playlist_items(playlist: str, max_results: int, as_json: bool) -> None:
    """プレイリスト内の動画一覧。"""
    pid = extract_playlist_id(playlist)
    data = api(
        "GET",
        "playlistItems",
        params={
            "part": "snippet,contentDetails",
            "playlistId": pid,
            "maxResults": max_results,
        },
    )
    if as_json:
        out(data, True)
        return
    for i, item in enumerate(data.get("items") or [], 1):
        sn = item["snippet"]
        vid = sn.get("resourceId", {}).get("videoId") or item.get("contentDetails", {}).get("videoId", "")
        click.echo(f"{i}. {sn['title']}")
        click.echo(f"   {vid}  item={item['id']}")


@playlist_group.command("remove-item")
@click.argument("playlist_item_id")
def playlist_remove_item(playlist_item_id: str) -> None:
    """プレイリストから1件削除 (playlistItems.id)。"""
    api("DELETE", "playlistItems", params={"id": playlist_item_id})
    click.echo(f"removed item {playlist_item_id}")


@playlist_group.command("delete")
@click.argument("playlist")
@click.option("--yes", is_flag=True, help="確認なしで削除")
def playlist_delete(playlist: str, yes: bool) -> None:
    """プレイリスト自体を削除。"""
    pid = extract_playlist_id(playlist)
    if not yes:
        click.confirm(f"delete playlist {pid} ?", abort=True)
    api("DELETE", "playlists", params={"id": pid})
    click.echo(f"deleted {pid}")


@main.command("me")
@click.option("--json", "as_json", is_flag=True)
def me_cmd(as_json: bool) -> None:
    """自分のチャンネル情報。"""
    data = api("GET", "channels", params={"part": "snippet,statistics,contentDetails", "mine": "true"})
    if as_json:
        out(data, True)
        return
    items = data.get("items") or []
    if not items:
        click.echo("(no channel)")
        return
    ch = items[0]
    sn = ch["snippet"]
    st = ch.get("statistics", {})
    click.echo(f"{sn['title']}  ({ch['id']})")
    click.echo(f"https://www.youtube.com/channel/{ch['id']}")
    click.echo(f"subs={st.get('subscriberCount')} videos={st.get('videoCount')} views={st.get('viewCount')}")


if __name__ == "__main__":
