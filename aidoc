#!/usr/bin/env python
import os

import click
from pydantic import BaseModel, Field
from xai_sdk import Client
from xai_sdk.chat import system, user
from xai_sdk.types.chat import ReasoningEffort

DEFAULT_LLM_MODEL = "grok-4.5"
DEFAULT_LLM_REASONING_EFFORT: ReasoningEffort = "low"
REASONING_EFFORTS = ["low", "medium", "high"]


class HTML(BaseModel):
    brief_summary: str = Field(
        description="Explanation of the content in a few sentences"
    )
    html_code: str = Field(description="Generated HTML code")


class MarkdownToHTML:
    def __init__(self, model: str, reasoning_effort: ReasoningEffort):
        self.model = model
        self.reasoning_effort: ReasoningEffort = reasoning_effort
        self.client = Client(api_key=os.environ.get("XAI_API_KEY"))

    def run(self, input: str, prompt) -> HTML:
        with open(input, "r") as f:
            markdown_text = f.read()
        system_prompt = """
<Role>
あなたは Markdown を HTML に変換する素晴らしい Generator です (pandoc のようなものを想定してください)。しかし単なる変換器ではありません。あなたは見る人に訴えかける美しい HTML ページをデザインできる素晴らしいフロントエンドデザイナーです。CSS や JavaScript を使用して、ページをより美しく、インタラクティブにすることができます。
</Role>
<Note>
Bootstrap や Tailwind CSS などの外部ライブラリは cdn から読み込むことができます。JavaScript も同様に cdn から読み込むことができます。
codeblock は prism.js を使って syntax highlight してください。
画像は Markdown の alt テキストをキャプションとして使用してください。
テキスト自体は元の Markdown に書かれていることを忠実に反映してください。Markdown に書かれていない内容から追加も削除もしてはいけません。
</Note>
"""
        session = self.client.chat.create(
            model=self.model,
            reasoning_effort=self.reasoning_effort,
        )
        session.append(system(system_prompt))
        if prompt:
            session.append(user(prompt))
        session.append(
            user(
                f"""<markdown>
{markdown_text}
</markdown>"""
            )
        )
        _, result = session.parse(HTML)
        return result


@click.command()
@click.argument("input", type=click.Path(exists=True))
@click.option("prompt", "-p", type=str, default="見栄えの良いHTMLに変換してください")
@click.option(
    "--model",
    "-m",
    type=str,
    default=DEFAULT_LLM_MODEL,
    show_default=True,
)
@click.option(
    "--reasoning-effort",
    "-r",
    type=click.Choice(REASONING_EFFORTS),
    default=DEFAULT_LLM_REASONING_EFFORT,
    show_default=True,
)
@click.option("--output", "-o", type=click.Path(), default=None)
def main(
    input: str,
    prompt: str,
    model: str,
    reasoning_effort: ReasoningEffort,
    output: str | None,
):
    generator = MarkdownToHTML(model, reasoning_effort)
    result = generator.run(input, prompt)
    click.secho(result.brief_summary, fg="green", err=True)
    if output is not None:
        with open(output, "w") as f:
            f.write(result.html_code)
    else:
        print(result.html_code)


if __name__ == "__main__":
    main()
